# Public values only: everything with EXPO_PUBLIC_ is inlined into the app bundle and is NOT secret.
# Copy to .env.local and adjust. Leave API_URL empty in development to auto-detect the Metro host.
EXPO_PUBLIC_API_URL=

# Google Sign-In (Google Cloud > APIs & Services > Credentials). Client ids are public.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Build-time only (used by app.config.ts): reversed iOS client id, com.googleusercontent.apps.<id>
GOOGLE_IOS_URL_SCHEME=

# RevenueCat public SDK key for the Test Store (development builds only; public, ships in the app)
EXPO_PUBLIC_REVENUECAT_TEST_KEY=
