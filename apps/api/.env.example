# Copy to .env.local. Never commit real values.
# Local: the docker-compose Postgres. Production: the Neon *pooled* connection string.
DATABASE_URL=postgres://plantpal:plantpal@localhost:5433/plantpal

# Signs our access tokens. Generate with: openssl rand -base64 48
JWT_SECRET=
# Comma-separated iOS bundle ids (the `aud` of Apple identity tokens)
APPLE_CLIENT_IDS=com.samilabud.plantpal.dev,com.samilabud.plantpal.preview,com.samilabud.plantpal
# Comma-separated Google OAuth *Web* client ids (the `aud` of Google ID tokens)
GOOGLE_CLIENT_IDS=
# Test-only sign-in for Maestro. Never true in production (also blocked on VERCEL_ENV=production).
ALLOW_DEV_AUTH=true
# Optional: Sign in with Apple key, used to revoke Apple access when an account is deleted
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Vercel Cron sends it as a Bearer token; the cron route rejects anything else. openssl rand -hex 24
CRON_SECRET=
# Optional: Expo push "enhanced security" access token (expo.dev > Access tokens)
EXPO_ACCESS_TOKEN=
# RevenueCat (M5). Secret key = server only (Project settings > API keys > secret key, v1).
REVENUECAT_SECRET_KEY=
# Exact Authorization header value configured on the RevenueCat webhook. openssl rand -hex 24
REVENUECAT_WEBHOOK_AUTH=
# HMAC signing secret (shown once when enabling webhook signing)
REVENUECAT_WEBHOOK_SECRET=
# Identify with AI (M9). Server only: console.anthropic.com > API keys. Never EXPO_PUBLIC_*.
ANTHROPIC_API_KEY=
# Optional tuning (defaults: claude-sonnet-5-5, low, adaptive). See docs/evidence/m9-ai-and-spanish.md
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=
ANTHROPIC_THINKING=
# Spending guard: USD per UTC day across all users (default 1). At the limit, AI answers "resting".
AI_DAILY_LIMIT=
