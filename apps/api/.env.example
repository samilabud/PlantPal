# Copy to .env.local. Never commit real values.
# Local: the docker-compose Postgres. Production: the Neon *pooled* connection string.
DATABASE_URL=postgres://plantpal:plantpal@localhost:5433/plantpal

# Signs our access tokens. Generate with: openssl rand -base64 48
JWT_SECRET=
# Comma-separated iOS bundle ids (the `aud` of Apple identity tokens)
APPLE_CLIENT_IDS=com.samilabud.plantpal.dev,com.samilabud.plantpal.preview,com.samilabud.plantpal
# Comma-separated Google OAuth *Web* client ids (the `aud` of Google ID tokens)
GOOGLE_CLIENT_IDS=
# Test-only sign-in for Maestro. Never true in production (also blocked on VERCEL_ENV=production).
ALLOW_DEV_AUTH=true
# Optional: Sign in with Apple key, used to revoke Apple access when an account is deleted
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Vercel Cron sends it as a Bearer token; the cron route rejects anything else. openssl rand -hex 24
CRON_SECRET=
# Optional: Expo push "enhanced security" access token (expo.dev > Access tokens)
EXPO_ACCESS_TOKEN=
