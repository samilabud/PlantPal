# Next's env loader ignores .env.local when NODE_ENV=test, so tests read this file instead.
# Copy to .env.test.local. CI sets the same values directly. All values are test-only.
DATABASE_URL=postgres://plantpal:plantpal@localhost:5433/plantpal_test
JWT_SECRET=test-only-secret-not-used-anywhere-real-0123456789
APPLE_CLIENT_IDS=com.samilabud.plantpal.dev
GOOGLE_CLIENT_IDS=test-web-client.apps.googleusercontent.com
ALLOW_DEV_AUTH=true
CRON_SECRET=test-only-cron-secret-0123456789
REVENUECAT_WEBHOOK_AUTH=Bearer test-only-webhook-auth
REVENUECAT_WEBHOOK_SECRET=test-only-webhook-signing-secret
