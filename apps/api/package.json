{
  "name": "@plantpal/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 4000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "env:pull": "vercel env pull .env.development.local --environment=development --yes",
    "test:ci": "vitest run --coverage --coverage.reporter=json-summary --coverage.reporter=text-summary --coverage.include=src/** --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml",
    "eval:photos": "tsx scripts/eval-photos.ts",
    "eval:identify": "tsx scripts/eval-identify.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@plantpal/shared": "workspace:*",
    "@vercel/blob": "^2.8.2",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "next": "16.4.1",
    "postgres": "^3.4.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.32.1"
}
